# ---------------------------------------------------------------
# Copie este arquivo para ".env" (mesma pasta) e preencha.
# O .env NÃO vai para o GitHub.
# ---------------------------------------------------------------

# Códigos individuais de acesso: um por pessoa, todos diferentes
# (4 a 40 letras minúsculas/números, "-" ou "_").
# Usados para gerar as regras do Firestore publicadas no Firebase.
# No Docker com emulador valem os códigos de TESTE: teste-pedro, teste-michele,
# teste-mercia, teste-carlos e teste-gabriel.
CODIGO_PEDRO=
CODIGO_MICHELE=
CODIGO_MERCIA=
CODIGO_CARLOS=
CODIGO_GABRIEL=

# Configuração do Firebase (banco real). Copie do console do Firebase:
# Configurações do projeto > Seus apps > App da Web > SDK setup and configuration.
# Estas MESMAS variáveis devem ser cadastradas na Vercel.
# (No Docker com emulador elas são ignoradas: o docker-compose.yml usa o projeto "demo-inventario".)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
