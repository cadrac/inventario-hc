rules_version = '2';

// Modelo das regras. NÃO edite firestore.rules diretamente: ele é gerado a partir
// deste arquivo (npm run rules), trocando __ACCESS_CODE__ pelo código do grupo.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Só quem entrou com o código do grupo tem um documento em /membros.
    function membro() {
      return logado() && exists(/databases/$(database)/documents/membros/$(request.auth.uid));
    }

    function nomeValido(n) {
      return n in ['Pedro', 'Michele', 'Mércia', 'Carlos', 'Gabriel'];
    }

    function texto(t, max) {
      return t is string && t.size() <= max;
    }

    function valorOk(v) {
      return v == null || ((v is int || v is float) && v >= 0 && v < 1000000000);
    }

    // Campos que o modal de edição/adição grava.
    function edicaoOk(d) {
      return texto(d.especificacao, 500) && d.especificacao.size() > 0
        && texto(d.qtd, 30)
        && texto(d.serie, 120)
        && valorOk(d.valor)
        && texto(d.observacoes, 500)
        && d.conservacaoNova in ['O', 'B', 'R', 'P', 'I']
        && d.conferido == true
        && nomeValido(d.editadoPor)
        && d.editadoEm == request.time;
    }

    match /membros/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['codigo', 'nome', 'entrouEm'])
        && request.resource.data.codigo == '__ACCESS_CODE__'
        && nomeValido(request.resource.data.nome)
        && request.resource.data.entrouEm == request.time;
      allow delete: if false;
    }

    // Excluir (vai para a lixeira) ou restaurar: só mexe nestes 4 campos.
    function exclusaoOk() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['excluido', 'excluidoPor', 'excluidoEm', 'motivoExclusao'])
        && d.excluido is bool
        && d.excluido != resource.data.get('excluido', false)
        && nomeValido(d.excluidoPor)
        && d.excluidoEm == request.time
        && texto(d.motivoExclusao, 300)
        // Excluir exige motivo (mínimo 3 letras); restaurar limpa o motivo.
        && (d.excluido == false || d.motivoExclusao.trim().size() >= 3);
    }

    match /itens/{id} {
      allow read: if membro();

      // Edição: só os campos editáveis. Item, setor e data de aquisição ficam travados.
      // Item na lixeira não pode ser editado (precisa restaurar antes).
      // Ou então: exclusão/restauração.
      allow update: if membro() && (
        (resource.data.get('excluido', false) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'especificacao', 'qtd', 'serie', 'valor', 'observacoes',
               'conservacaoNova', 'conferido', 'editadoPor', 'editadoEm'])
          && edicaoOk(request.resource.data))
        || exclusaoOk()
      );

      // Adição de objeto encontrado na visita.
      allow create: if membro()
        && request.resource.data.keys().hasOnly([
             'novo', 'numero', 'comodo', 'comodoId', 'setorOriginal', 'dataAquisicao',
             'conservacaoOriginal', 'especificacao', 'qtd', 'serie', 'valor', 'observacoes',
             'conservacaoNova', 'conferido', 'editadoPor', 'editadoEm', 'criadoPor', 'criadoEm'])
        && request.resource.data.novo == true
        && request.resource.data.numero == null
        && texto(request.resource.data.comodo, 100)
        && texto(request.resource.data.comodoId, 100)
        && request.resource.data.setorOriginal == request.resource.data.comodo
        && request.resource.data.dataAquisicao == ''
        && request.resource.data.conservacaoOriginal == null
        && request.resource.data.criadoPor == request.resource.data.editadoPor
        && request.resource.data.criadoEm == request.time
        && edicaoOk(request.resource.data);

      allow delete: if false;
    }

    // Presença (aba Equipe): cada aparelho só escreve a própria, com o mesmo nome
    // usado para entrar e a hora do servidor. Todos os membros podem ler.
    match /presenca/{uid} {
      allow read: if membro();
      allow create, update: if membro() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'aparelho', 'vistoEm'])
        && request.resource.data.nome == get(/databases/$(database)/documents/membros/$(request.auth.uid)).data.nome
        && texto(request.resource.data.aparelho, 60)
        && request.resource.data.vistoEm == request.time;
      allow delete: if false;
    }

    // Histórico: qualquer membro registra, ninguém altera nem apaga.
    match /historico/{id} {
      allow read: if membro();
      allow create: if membro()
        && request.resource.data.keys().hasOnly([
             'tipo', 'itemId', 'numero', 'comodo', 'especificacao', 'por', 'em', 'mudancas', 'motivo'])
        && request.resource.data.tipo in ['conferencia', 'edicao', 'adicao', 'exclusao', 'restauracao']
        && texto(request.resource.data.itemId, 100)
        && (request.resource.data.numero == null || request.resource.data.numero is int)
        && texto(request.resource.data.comodo, 100)
        && texto(request.resource.data.especificacao, 500)
        && nomeValido(request.resource.data.por)
        && request.resource.data.em == request.time
        && request.resource.data.mudancas is list
        && request.resource.data.mudancas.size() <= 10
        && texto(request.resource.data.motivo, 300)
        && (request.resource.data.tipo != 'exclusao' || request.resource.data.motivo.trim().size() >= 3);
      allow update, delete: if false;
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
